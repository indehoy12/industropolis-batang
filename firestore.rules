rules_version = '2';

// Industropolis Futsal League 2026
// - Siapa pun boleh MEMBACA (website publik).
// - Hanya akun admin yang boleh MENULIS, dikenali lewat UID (bukan email, supaya
//   tidak terbaca di repositori publik). Cara mencari UID: Firebase Console ->
//   Authentication -> Users -> salin kolom "User UID".
// - Untuk lebih dari satu admin: ['uid-satu', 'uid-dua']

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ['5qf5QnrOkZRSypbAxA4zaxg4S3P2'];
    }

    // Logo tim disimpan sebagai gambar kecil di dokumen tim; batasi ukurannya.
    function smallLogo() {
      return !('logoUrl' in request.resource.data)
        || request.resource.data.logoUrl == null
        || (request.resource.data.logoUrl is string && request.resource.data.logoUrl.size() < 200000);
    }

    match /settings/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /teams/{id}     { allow read: if true; allow write: if isAdmin() && smallLogo(); }
    match /players/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /matches/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /events/{id}    { allow read: if true; allow write: if isAdmin(); }

    // Selain itu ditutup.
    match /{document=**} { allow read, write: if false; }
  }
}
